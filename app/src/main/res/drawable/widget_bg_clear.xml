<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted-glass look: a faint white tint, a soft top-left sheen, and a thin bright edge.
     (Android widgets cannot blur the wallpaper behind them, so the effect is drawn, not blurred.) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1CFFFFFF"/>
            <corners android:radius="28dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#3DFFFFFF" android:centerColor="#08FFFFFF" android:endColor="#1AFFFFFF"/>
            <corners android:radius="28dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#26FFFFFF" android:endColor="#00FFFFFF"/>
            <corners android:radius="28dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#59FFFFFF"/>
            <corners android:radius="28dp"/>
        </shape>
    </item>
</layer-list>
