<?xml version="1.0" encoding="utf-8"?>
<!-- Shown while the car's climate is heating: the frosted glass with a red glow around the edge
     (soft inner rings fading towards the middle, then a bright red line on the outside). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1CFFFFFF"/>
            <corners android:radius="28dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#26FFFFFF" android:endColor="#00FFFFFF"/>
            <corners android:radius="28dp"/>
        </shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <stroke android:width="3dp" android:color="#1AFF3B30"/>
            <corners android:radius="23dp"/>
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <stroke android:width="3dp" android:color="#40FF3B30"/>
            <corners android:radius="25dp"/>
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#B3FF3B30"/>
            <corners android:radius="27dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1.5dp" android:color="#FFFF3B30"/>
            <corners android:radius="28dp"/>
        </shape>
    </item>
</layer-list>
